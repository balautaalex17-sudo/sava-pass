{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "comment:browserslist": "Modern targets only — drops Next/SWC legacy polyfills (Array.at/flat/flatMap, Object.fromEntries/hasOwn, String trim*) that PageSpeed flagged as unused on modern phones. SavaPass's 2026 audience is all well past these.",
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env.local --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.mjs",
    "test:security": "node --import tsx --test tests/security-remediation.test.ts",
    "test:staging": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-staging-test-suite.ps1 -Mode integration",
    "verify:staging-env": "node --env-file=../active/.env.staging scripts/verify-staging-environment.mjs",
    "test:browser": "node scripts/evenimente-browser-check.mjs --mode audit",
    "test:browser:staging": "node scripts/verify-staging-browser.mjs https://sava-pass-staging.vercel.app",
    "test:roles:staging": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-staging-test-suite.ps1 -Mode roles",
    "stress:staging": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-staging-stress.ps1",
    "test:live-flows:staging": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-staging-live-flows.ps1",
    "seed:staff-test": "node --env-file=.env.local scripts/seed-staff-test-accounts.mjs",
    "seed:staff-test:staging": "node --env-file=../active/.env.staging scripts/seed-staff-test-accounts.mjs",
    "seed:interviewer-examples": "node --env-file=.env.local scripts/seed-interviewer-examples.mjs",
    "seed:interviewer-examples:staging": "node --env-file=../active/.env.staging scripts/seed-interviewer-examples.mjs",
    "seed:demo:staging": "node --env-file=../active/.env.staging scripts/seed-staging-demo.mjs",
    "verify:event-media": "node scripts/verify-event-media.mjs",
    "sync:instagram-events": "node scripts/sync-instagram-events.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.7.1",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "lucide-react": "^1.17.0",
    "next": "16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "read-excel-file": "9.3.10",
    "resend": "^6.12.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "4.23.12",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion@<=1.1.17": "1.1.18",
    "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
    "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
    "nanoid@<3.3.18": "3.3.18"
  }
}
